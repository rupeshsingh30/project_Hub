<div class="card">
    <div class="card-header" id="<%= id %>">
        <h5 class="mb-0">
            <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#<%= id2 %>" aria-expanded="true" aria-controls="<%= id2 %>">
                <%=label %>
            </button>
        </h5>
    </div>

    <div id="<%= id2 %>" class="collapse" aria-labelledby="<%= id %>" data-parent="#accordion">
        <div class="card-body">
            <%- include('details', {
                managerId: 'deliveryManagerId',
                teamMembersId: 'deliveryTeamMembersId'
            }) %>
  
        </div>
    </div>
</div>