<div class="form-group mt-4">
    <label>Previous Phases</label>
    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Phase</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% phases.forEach(phase => { %>
                <tr>
                    <td><%= phase.phase %></td>
                    <td><%= phase.start_date %></td>
                    <td><%= phase.end_date %></td>
                    <td><%= phase.status %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>